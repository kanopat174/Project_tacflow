{
  "name": "Jodwise จดไว้ — วางแผนภาษีและสมุดบัญชี",
  "short_name": "Jodwise",
  "description": "คำนวณภาษี วางแผนลดหย่อน และจดรายรับรายจ่ายในที่เดียว",
  "lang": "th",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f6fbfa",
  "theme_color": "#0f8f86",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "files", "accept": ["image/jpeg", "image/png", "image/webp", "application/pdf"] }]
    }
  },
  "shortcuts": [
    {
      "name": "จดรายจ่าย",
      "short_name": "จดรายจ่าย",
      "url": "/dashboard?quick=expense",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "จดรายรับ",
      "short_name": "จดรายรับ",
      "url": "/dashboard?quick=income",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "สแกนสลิป",
      "short_name": "สแกนสลิป",
      "url": "/dashboard?quick=slip",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "พูดจด",
      "short_name": "พูดจด",
      "url": "/dashboard?quick=voice",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
